<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Принудительный редирект на HTTPS — без этого правила сервер отдавал
    # http:// напрямую с кодом 200, никак не подталкивая к защищённому
    # соединению.
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Если запрошенный путь — не файл и не папка, и ещё не .html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.html$
    # Добавляем .html к пути (один раз — условие выше не даёт применить
    # правило повторно к уже переписанному запросу и уйти в петлю
    # внутренних редиректов, из-за которой отсутствующие страницы
    # отдавали 500 вместо 404)
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Своя страница вместо стандартной страницы хостера при 404.
ErrorDocument 404 /404.html
